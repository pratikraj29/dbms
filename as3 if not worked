-- 1
SELECT TO_CHAR(SYSDATE, 'DD-MON-YYYY HH24:MI:SS') AS CURRENT_DATE_TIME
FROM DUAL;

-- 2
SELECT empno, ename, sal,
       ROUND(sal * 1.15) AS "new Salary"
FROM emp;

-- 3
SELECT empno, ename, sal,
       ROUND(sal * 1.15) AS "new Salary",
       ROUND(sal * 1.15) - sal AS increase
FROM emp;

-- 4
SELECT ename, hiredate,
       TO_CHAR(hiredate, 'DAY') AS day
FROM emp;

-- 5
SELECT ename, hiredate
FROM emp
WHERE EXTRACT(YEAR FROM hiredate) = 1982;

-- 6
SELECT ename || ' ' || job AS employee_job
FROM emp;

-- 7
SELECT 'Employee ' || ename ||
       ' works in Department no. ' || deptno ||
       ' and earns Rs.' || sal ||
       ' per month as salary' AS employee_details
FROM emp;

-- 8
SELECT ename,
       TO_CHAR(hiredate, 'DD FMMonth YYYY') AS hire_date
FROM emp;

-- 9
SELECT UPPER(SUBSTR(ename, 1, 2)) ||
       LOWER(SUBSTR(ename, 3)) AS ename
FROM emp;

-- 10
SELECT ename
FROM emp
WHERE REGEXP_LIKE(ename, '^[^T]*T[^T]*$');

-- 11
SELECT ename,
       TRUNC(MONTHS_BETWEEN(SYSDATE, hiredate) / 12) AS experience_years
FROM emp
WHERE job = 'MANAGER';

-- 12
SELECT *
FROM emp
WHERE ROWNUM = 1;

-- 13
SELECT MAX(ROWNUM) AS highest_row_number
FROM emp;

-- 14
SELECT ename, sal
FROM emp
ORDER BY sal DESC
FETCH FIRST 2 ROWS ONLY;
