1. Write a query to show the emp table.

SELECT *
FROM EMP;


2. Write a query to show the annual salary of all employees with a new field name.

SELECT ENAME, SAL, SAL * 12 AS ANNUAL_SALARY
FROM EMP;


3. Display the employee name who hired after '19-APR-1987'.

SELECT ENAME
FROM EMP
WHERE HIREDATE > TO_DATE('19-APR-1987', 'DD-MON-YYYY');


4. Create a query to display a unique job.

SELECT DISTINCT JOB
FROM EMP;


5. Display details of all clerks.

SELECT *
FROM EMP
WHERE JOB = 'CLERK';


6. Display the employee number, employee name, job and department of JAMES.

SELECT EMPNO, ENAME, JOB, DEPTNO
FROM EMP
WHERE ENAME = 'JAMES';


7. Display the name of all employees whose name has an 'A' as the second character.

SELECT ENAME
FROM EMP
WHERE ENAME LIKE '_A%';


8. Display the employee who has no manager.

SELECT *
FROM EMP
WHERE MGR IS NULL;


9. Display the details of all clerk who earn more than 1100.

SELECT *
FROM EMP
WHERE JOB = 'CLERK'
AND SAL > 1100;


10. Display the employee name and department number of all employees in department 10 and department 30 in alphabetical order by name.

SELECT ENAME, DEPTNO
FROM EMP
WHERE DEPTNO IN (10, 30)
ORDER BY ENAME ASC;


11. Display the name and salary of employees who earn more than 1500 and are in department 10 or 30.

SELECT ENAME, SAL
FROM EMP
WHERE SAL > 1500
AND DEPTNO IN (10, 30);


12. Display the name, salary and commission for all employees who earn commissions. Sort the data in descending order of salary.

SELECT ENAME, SAL, COMM
FROM EMP
WHERE COMM IS NOT NULL
ORDER BY SAL DESC;


13. Display the name of all employees who have double L in their name.

SELECT ENAME
FROM EMP
WHERE ENAME LIKE '%LL%';


14. Write a query to display the current date.

SELECT SYSDATE
FROM DUAL;


15. Write a query that will display all employee name in lower case and the length of their name.

SELECT LOWER(ENAME) AS EMPLOYEE_NAME,
       LENGTH(ENAME) AS NAME_LENGTH
FROM EMP;
